# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/seminary_greek?schema=public"

# Supabase (optional — use Supabase OR plain Postgres)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Paddle ($10/yr student subscription — Paddle Billing, not Classic)
NEXT_PUBLIC_PADDLE_ENV="sandbox"                      # sandbox | production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_..."            # Paddle dashboard → Developer Tools → Authentication
NEXT_PUBLIC_PADDLE_PRICE_ID_STUDENT_ANNUAL="pri_..."  # the $10/year price
PADDLE_API_KEY="..."                                  # Developer Tools → Authentication (server-side key)
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."                 # Developer Tools → Notifications → your webhook destination
