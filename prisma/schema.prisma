generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users & Auth ────────────────────────────────────────────────

enum Role {
  INSTRUCTOR
  STUDENT
  ADMIN
}

model User {
  id          String   @id @default(cuid())
  firstName   String
  surname     String
  title       String?
  email       String   @unique
  password    String
  role        Role
  institution String?
  // Instructors created via self-registration start unapproved and must be
  // approved by an admin before they can sign in. Students/admins are auto-approved.
  approved    Boolean  @default(true)
  // Set true when an admin creates an account with a temporary password — the user
  // is forced to set their own password on first sign-in. Cleared on successful change.
  mustChangePassword Boolean @default(false)
  // Soft-delete timestamp. The admin DELETE endpoint sets this instead of dropping the row.
  // Sign-in and all queries filter out users with deletedAt set. Reversible by clearing it.
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instructorCourses  Course[]              @relation("InstructorCourses")
  coInstructorOf     CourseCoInstructor[]
  enrollments        Enrollment[]
  responses          Response[]
  quizAttempts       QuizAttempt[]
  flashcardProgress  FlashcardProgress[]
  createdAssignments Assignment[]          @relation("CreatedAssignments")
  exegesisSessions   ExegesisSession[]
  sentMessages       Message[]             @relation("SentMessages")
  receivedMessages   Message[]             @relation("ReceivedMessages")
  vocabAppeals       VocabAppeal[]
  ownedMaterials     Material[]            @relation("InstructorMaterials")
  ownedFolders       MaterialFolder[]      @relation("InstructorFolders")

  @@index([email])
}

// ─── Institutions ────────────────────────────────────────────────

model Institution {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  courses Course[]
}

// ─── Courses ─────────────────────────────────────────────────────

enum CourseLevel {
  BEGINNING
  INTERMEDIATE
  ADVANCED
  GREEK_I
  GREEK_II
  GREEK_III
  SEPTUAGINT
}

model Course {
  id            String      @id @default(cuid())
  name          String
  listing       String?
  level         CourseLevel
  startDate     DateTime
  endDate       DateTime
  institutionId String?
  instructorId  String
  isArchived    Boolean     @default(false)
  // Final-grade weighting by assignment-type category, e.g.
  // { VOCABULARY_QUIZ: 40, TRANSLATION_EXERCISE: 30, TRANSLATION_EXAM: 30 }.
  // Null = no custom weighting (the gradebook overall is a flat average).
  gradeCategoryWeights Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  instructor     User                @relation("InstructorCourses", fields: [instructorId], references: [id])
  institution    Institution?        @relation(fields: [institutionId], references: [id])
  coInstructors  CourseCoInstructor[]
  enrollments    Enrollment[]
  assignments    Assignment[]
  materials      Material[]
  materialShares MaterialShare[]
  folderShares   FolderShare[]
  messages       Message[]

  @@index([instructorId])
}

model CourseCoInstructor {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String
  status    EnrollmentStatus @default(APPROVED)
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status])
}

// ─── Biblical Texts ───────────────────────────────────────────────

enum Corpus {
  LXX
  GNT
}

model BiblicalBook {
  id         String @id @default(cuid())
  corpus     Corpus
  osisId     String @unique
  name       String
  abbrev     String
  totalChapters Int

  verses BiblicalVerse[]

  @@index([corpus])
}

model BiblicalVerse {
  id        String @id @default(cuid())
  bookId    String
  chapter   Int
  verse     Int
  reference String
  text      String

  book  BiblicalBook @relation(fields: [bookId], references: [id])
  words VerseWord[]

  @@unique([bookId, chapter, verse])
  @@index([reference])
  @@index([bookId, chapter])
}

model VerseWord {
  id          String @id @default(cuid())
  verseId     String
  position    Int
  surface     String
  lexemeId    String?

  verse  BiblicalVerse @relation(fields: [verseId], references: [id])
  lexeme LexicalEntry? @relation(fields: [lexemeId], references: [id])
  parses MorphParse[]

  @@index([verseId])
  @@index([surface])
}

// ─── Lexicon ──────────────────────────────────────────────────────

model LexicalEntry {
  id           String  @id @default(cuid())
  lexeme       String  @unique
  strongs      String?
  gloss        String
  extendedGloss String?
  partOfSpeech String
  frequency    Int     @default(0)
  // Comma-separated additional English glosses that are accepted as correct in
  // vocab quizzes for this lemma. Instructor-curated. Empty/null = no extra
  // synonyms (the quiz's own correctAnswer field is still used).
  acceptedAnswers String?

  words       VerseWord[]
  parses      MorphParse[]
  vocabItems  VocabularyItem[]
  flashcards  Flashcard[]

  @@index([lexeme])
  @@index([frequency])
}

// ─── Morphology ───────────────────────────────────────────────────

model MorphParse {
  id          String  @id @default(cuid())
  wordId      String
  lexemeId    String
  surface     String
  partOfSpeech String
  casus       String?
  number      String?
  gender      String?
  tense       String?
  voice       String?
  mood        String?
  person      String?
  degree      String?
  extraInfo   String?

  word   VerseWord    @relation(fields: [wordId], references: [id])
  lexeme LexicalEntry @relation(fields: [lexemeId], references: [id])

  @@index([wordId])
  @@index([lexemeId])
}

// ─── Vocabulary ───────────────────────────────────────────────────

enum FrequencyLevel {
  BEGINNING
  INTERMEDIATE
}

model VocabularyItem {
  id           String         @id @default(cuid())
  lexemeId     String
  level        FrequencyLevel
  sortOrder    Int

  lexeme     LexicalEntry @relation(fields: [lexemeId], references: [id])
  flashcards Flashcard[]

  @@unique([lexemeId, level])
}

// ─── Assignments ─────────────────────────────────────────────────

enum AssignmentType {
  VOCABULARY_QUIZ
  PASSAGE_VOCABULARY
  MORPHOLOGY_QUIZ
  TRANSLATION_EXERCISE
  TRANSLATION_EXAM
}

model Assignment {
  id           String         @id @default(cuid())
  courseId     String
  createdById  String
  title        String
  type         AssignmentType
  weekNumber   Int
  dueDate      DateTime
  level        CourseLevel
  reference           String?
  instructions        String?
  opensAt             DateTime?  // translation exams: students cannot start before this time
  submissionDeadline  DateTime?  // translation exercises: cut-off for new submissions; editing still allowed after
  round1Deadline      DateTime?  // translation exercises: absolute cut-off for Round 1 annotations (to the minute)
  round2Deadline      DateTime?  // translation exercises: absolute cut-off for Round 2 corrections (to the minute)
  timePerQuestion Int?           // seconds per question; null = untimed
  reviewTimeSeconds Int?         // stage-2 review/correction time limit (seconds); null = unlimited
  allowLate    Boolean        @default(false)
  lateDaysLimit Int?           // days after dueDate late submissions are accepted; null = no limit
  provideDefinition Boolean   @default(false)
  // Translation exercises: show a glossary of words rarer than this NT frequency
  // under each verse (e.g. 50 = beginner, 30 = intermediate). Null = no glossary.
  glossFrequency Int?
  // Translation exams: relative weights (percent) for the parsing/syntax/translation
  // sub-scores when computing each passage grade. { parsing, syntax, translation }. Null = equal.
  gradeWeights Json?
  // Translation exams: "lockdown" integrity mode. When on, the exam requires fullscreen,
  // detects tab/window switching, blocks copy/paste, and logs integrity events.
  lockdown    Boolean  @default(false)
  // Auto-submit the exam after this many integrity violations (null = warn only, never auto-submit).
  lockdownMaxViolations Int?
  // Translation exercises: when true, students may consult Reader info (parsing, gloss, lexicon)
  // for the clicked word during Round 2 corrections. Default false to preserve existing behavior.
  allowReaderInRound2 Boolean  @default(false)
  // Vocab quizzes: max number of student appeals per attempt. Null/0 = appeals disabled.
  maxAppeals  Int?
  maxRetakes   Int?
  morphSubtype String?        // For MORPHOLOGY_QUIZ: VERB | NOUN | ADJECTIVE | PRONOUN | CONDITIONAL | SUBJUNCTIVE
  // For VOCABULARY_QUIZ: the instructor's word selection from the BGVB list —
  // { subsections: string[] (e.g. ["1-A","2-B"]), pos: string[] }. Lets the edit
  // page pre-fill the picker and regenerate from the same words.
  vocabSelection Json?
  isPublished  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy  User          @relation("CreatedAssignments", fields: [createdById], references: [id])
  questions  Question[]
  responses  Response[]
  attempts   QuizAttempt[]
  appeals    VocabAppeal[]

  @@index([courseId])
}

// ─── Questions ────────────────────────────────────────────────────

enum QuestionType {
  GREEK_TO_ENGLISH
  ENGLISH_TO_GREEK
  MULTIPLE_CHOICE
  MATCHING
  MORPHOLOGY_IDENTIFY
  TRANSLATION
  SYNTAX_IDENTIFY
}

model Question {
  id           String       @id @default(cuid())
  assignmentId String
  position     Int
  type         QuestionType
  prompt       String
  correctAnswer String
  options      String[]
  points       Int          @default(1)
  reference    String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  responses  Response[]
  appeals    VocabAppeal[]

  @@index([assignmentId])
}

// ─── Quiz Attempts ────────────────────────────────────────────────

model QuizAttempt {
  id            String   @id @default(cuid())
  userId        String
  assignmentId  String
  attemptNumber Int
  earnedPoints  Float
  totalPoints   Float
  percentage    Int
  isBest        Boolean  @default(false)
  completedAt   DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([userId, assignmentId])
}

// ─── Student Responses ────────────────────────────────────────────

model Response {
  id           String   @id @default(cuid())
  userId       String
  assignmentId String
  questionId   String?
  answer       String
  isCorrect    Boolean?
  score        Float?
  submittedAt  DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   Question?  @relation(fields: [questionId], references: [id])
  appeal     VocabAppeal?

  @@index([userId, assignmentId])
}

// ─── Flashcards ───────────────────────────────────────────────────

model Flashcard {
  id           String  @id @default(cuid())
  lexemeId     String
  vocabItemId  String?
  level        FrequencyLevel
  front        String
  backLexeme   String
  backGloss    String
  backParsing  String?

  lexeme    LexicalEntry   @relation(fields: [lexemeId], references: [id])
  vocabItem VocabularyItem? @relation(fields: [vocabItemId], references: [id])
  progress  FlashcardProgress[]

  @@unique([lexemeId, level])
}

model FlashcardProgress {
  id              String   @id @default(cuid())
  userId          String
  flashcardId     String
  easeFactor      Float    @default(2.5)
  interval        Int      @default(1)
  repetitions     Int      @default(0)
  nextReviewDate  DateTime @default(now())
  lastReviewDate  DateTime?
  knownCount      Int      @default(0)
  unknownCount    Int      @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id])

  @@unique([userId, flashcardId])
  @@index([userId, nextReviewDate])
}

// ─── Materials (instructor uploads) ──────────────────────────────

model Material {
  id          String   @id @default(cuid())
  // Legacy direct-course attachment (kept for backward compat). New library files
  // live in a folder and are shared to courses via MaterialShare instead.
  courseId    String?
  folderId    String?
  instructorId String?
  title       String
  description String?
  fileUrl     String?
  content     String?
  weekNumber  Int?
  // Physical file in Supabase Storage. Null for link-only or text materials.
  storagePath  String?
  mimeType     String?
  sizeBytes    Int?
  originalName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course     Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  folder     MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  instructor User?           @relation("InstructorMaterials", fields: [instructorId], references: [id])
  shares     MaterialShare[]

  @@index([courseId])
  @@index([folderId])
  @@index([instructorId])
}

// A folder in an instructor's shared materials library. Self-referencing tree.
model MaterialFolder {
  id           String   @id @default(cuid())
  name         String
  parentId     String?
  instructorId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent     MaterialFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   MaterialFolder[] @relation("FolderTree")
  instructor User             @relation("InstructorFolders", fields: [instructorId], references: [id])
  materials  Material[]
  shares     FolderShare[]

  @@index([parentId])
  @@index([instructorId])
}

// Shares an individual file with a course.
model MaterialShare {
  id         String   @id @default(cuid())
  materialId String
  courseId   String
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([materialId, courseId])
  @@index([courseId])
}

// Shares a folder (and everything inside it) with a course.
model FolderShare {
  id        String   @id @default(cuid())
  folderId  String
  courseId  String
  createdAt DateTime @default(now())

  folder MaterialFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  course Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([folderId, courseId])
  @@index([courseId])
}

// ─── Exegesis Workspace ───────────────────────────────────────────

model ExegesisSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String?   // optional — set when linked to a Translation Exercise assignment
  title        String
  bookOsisId   String
  bookName     String
  chapter      Int
  verseStart   Int
  verseEnd     Int
  // JSON map: { [wordKey]: { parsing: string, syntax: string, translation: string } }
  // wordKey = "verseNum-wordId"
  annotations           Json      @default("{}")
  corrections           Json      @default("{}")   // post-timer review edits; tracked separately, shown in red
  verseTranslations     Json      @default("{}")   // Round 1 whole-verse translations: { [verseNumber]: string }
  verseCorrections      Json      @default("{}")   // Round 2 whole-verse notes/corrections: { [verseNumber]: string }
  submittedAnnotations  Json?                      // snapshot of annotations at submit time; post-deadline edits show as diff
  // Free-form "Notes & Questions" scratchpad the student fills in across Round 1 & 2.
  // Live until submission, then locked; shown to the instructor in the submission viewer.
  notes        String    @default("")
  startedAt    DateTime?
  submittedAt  DateTime?
  grade        Int?      // instructor-entered score 0-100 (exams: the average of passageGrades)
  gradeNote    String?   // instructor feedback
  passageGrades Json?    // translation exams: per-passage sub-scores { [reference]: { parsing, syntax, translation } }
  integrityEvents Json?  // lockdown exams: array of { type, at } violation events logged during the exam
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([assignmentId])
}

// Internal course messaging — instructors send announcements/messages to a whole
// class or an individual student. Fan-out model: one row per recipient, so each
// student has independent read state. A "whole class" send shares a broadcastId.
model Message {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  broadcastId String?   // groups a single "to whole class" send
  // Conversation thread key = the root message's id. Root messages leave this null
  // (their thread key is their own id); replies carry the root id here.
  threadId    String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([courseId])
  @@index([senderId, broadcastId])
  @@index([threadId])
}

// Audit log — records sensitive admin/instructor actions for after-the-fact review.
// Append-only, intentionally not foreign-keyed to the User table so records survive
// even if the actor or target is later soft-deleted.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // who performed the action (null = system/script)
  actorEmail String?  // captured at action time, in case the actor is later deleted
  action     String   // e.g. "user.create", "user.softDelete", "user.roleChange", "course.delete"
  targetType String?  // e.g. "User", "Course", "Assignment"
  targetId   String?  // id of the affected row
  // Snapshot of relevant fields before/after — keeps the log self-contained
  before     Json?
  after      Json?
  // Free-form context (IP, route, justification, etc.). Never include secrets.
  context    Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ─── Vocab quiz appeals ─────────────────────────────────────────────
//
// A student appeals a single wrong vocab answer. Flow:
//   1. Student clicks "Appeal" on a wrong answer (per-quiz cap enforced).
//   2. Instructor sees pending appeals on /instructor/appeals and Accept/Reject.
//      Accept → response is flipped correct, quiz score is recomputed, audit-logged.
//      Reject → no grade change.
//   3. On instructor-accept, the appeal is forwarded to admin queue. Admin Accept
//      adds the student's answer to LexicalEntry.acceptedAnswers. Admin Reject
//      leaves the lexicon untouched but the student's grade still stands.

enum AppealDecision {
  PENDING
  ACCEPTED
  REJECTED
  NOT_APPLICABLE   // admin tier: never reached because instructor rejected first
}

model VocabAppeal {
  id            String   @id @default(cuid())

  // Who and what is being appealed
  studentId     String
  assignmentId  String
  responseId    String   @unique  // one appeal per Response row (deleted-cascade when a new best attempt rewrites responses)
  questionId    String
  studentAnswer String

  // Instructor tier — controls the student's grade
  instructorDecision   AppealDecision  @default(PENDING)
  instructorDecidedAt  DateTime?
  instructorNote       String?

  // Admin tier — controls the global lexicon. NOT_APPLICABLE when instructor rejected.
  adminDecision        AppealDecision  @default(PENDING)
  adminDecidedAt       DateTime?
  adminNote            String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student     User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  response    Response   @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([studentId, assignmentId])
  @@index([assignmentId, instructorDecision])
  @@index([instructorDecision, adminDecision])
}
